---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";

import globeSignpost from "../../assets/newsletter/globe-signpost.webp";
import airplaneTrail from "../../assets/newsletter/airplane-trail.webp";
import passportStamp from "../../assets/newsletter/passport-stamp.webp";
import curiousKids from "../../assets/newsletter/curious-kids.webp";
import bigPlaces from "../../assets/newsletter/big-places.webp";
import heartRays from "../../assets/newsletter/heart-rays.webp";
import starGold from "../../assets/newsletter/star-gold.webp";
import starTeal from "../../assets/newsletter/star-teal.webp";

const brand = await getEntry("brand", "site");
const { kitAction, successHeadline, successBody } = brand.data.newsletter;

// Wired to the Kit inline form (uid ca05039a86, form 9894656), using our own
// markup so none of Kit's formkit-* CSS lands on the page.
//
// IMPORTANT: a plain HTML form POST to this URL does NOT subscribe anyone. It
// 302s to a generic success page for any input at all — even an empty address.
// Kit's v5 forms only really subscribe when the request asks for JSON, exactly
// as their own ck.5.js does:
//     Accept: application/json  +  X-CKJS-Version: 6
// which returns {"status":"success"|"quarantined"|...,"errors":{...}}.
// The script below does that with fetch(), so success and failure are both
// real. The endpoint sends Access-Control-Allow-Origin: *, so no proxy or
// third-party script is needed.
// The URL lives in src/content/brand/site.json → newsletter.kitAction.
const configured = !kitAction.includes("REPLACE_FORM_ID");

// Decorative scatter stars, placed as percentages of the artwork.
const goldStars = [
  { left: "8.4%", top: "12.8%", w: 34 },
  { left: "95.4%", top: "10.1%", w: 30 },
  { left: "91.0%", top: "37.2%", w: 30 },
  { left: "22.4%", top: "73.3%", w: 34 },
  { left: "78.4%", top: "74.2%", w: 26 },
  { left: "74.5%", top: "84.5%", w: 32 },
];
const dots = [
  { left: "11.7%", top: "16.8%", w: 7, c: "#4E9CA6" },
  { left: "95.0%", top: "40.6%", w: 8, c: "#4E9CA6" },
  { left: "24.6%", top: "79.2%", w: 8, c: "#4E9CA6" },
  { left: "76.0%", top: "69.1%", w: 7, c: "#4E9CA6" },
  { left: "97.5%", top: "16.2%", w: 6, c: "#8fb0c4" },
];
---

<section id="signup" class="signup">
  <div class="art" aria-hidden="true">
    <Image class="d d-globe" src={globeSignpost} alt="" widths={[400, 800]} sizes="24vw" />
    <Image class="d d-plane" src={airplaneTrail} alt="" widths={[522, 1044]} sizes="31vw" />
    <Image class="d d-passport" src={passportStamp} alt="" widths={[332, 664]} sizes="20vw" />
    <Image class="d d-curious" src={curiousKids} alt="" widths={[195, 390]} sizes="12vw" />
    <Image class="d d-big" src={bigPlaces} alt="" widths={[165, 330]} sizes="10vw" />
    <Image class="d d-star-teal" src={starTeal} alt="" widths={[42, 84]} sizes="42px" />
    {goldStars.map((s) => (
      <Image
        class="d d-star"
        src={starGold}
        alt=""
        widths={[40, 80]}
        sizes="40px"
        style={`left:${s.left};top:${s.top};width:${s.w}px`}
      />
    ))}
    {dots.map((d) => (
      <span
        class="dot"
        style={`left:${d.left};top:${d.top};width:${d.w}px;height:${d.w}px;background:${d.c}`}
      ></span>
    ))}
  </div>

  <Container>
    <div class="wrap">
      <Image class="heart-top" src={heartRays} alt="" widths={[165, 330]} sizes="92px" />

      <h2>Not ready to travel just yet?</h2>
      <p class="sub sub-lead">Start your family's passport — free.</p>
      <p class="sub">
        Get the printable Kids' Passport to track every country
        you visit. Print it tonight, and take your first trip whenever you're
        ready. Plus first dibs when new countries land.
      </p>

      <form class="kit" action={kitAction} method="post" aria-label="Email signup"
            data-analytics-submit="newsletter_submit" data-analytics-location="footer_signup">
        <label class="sr-only" for="email">Email address</label>
        <div class="field">
          <svg class="env" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2.4" y="4.8" width="19.2" height="14.4" rx="2.4"
                  stroke="currentColor" stroke-width="1.9" />
            <path d="M3.4 7 12 13.2 20.6 7" stroke="currentColor"
                  stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <input id="email" name="email_address" type="email" required
                 placeholder="you@example.com" autocomplete="email" />
        </div>
        <button type="submit">Send me the free passport <span aria-hidden="true">→</span></button>
      </form>

      <div class="kit-success" hidden>
        <p class="kit-success-head">{successHeadline}</p>
        <p class="kit-success-body">{successBody}</p>
      </div>
      <p class="kit-error" role="alert" hidden></p>
      <p class="hint">No spam. Just good stuff for curious families.</p>

      {!configured && (
        <p class="setup-note" data-dev>
          ⚙️ Setup: paste your Kit form action URL into
          <code>src/content/brand/site.json</code> → <code>newsletter.kitAction</code>.
        </p>
      )}

      <p class="tagline">
        <span class="tagline-part">Small moments. </span><span class="tagline-sep"> </span><span class="tagline-part">A bigger world. &#127757;</span>
      </p>
    </div>
  </Container>
</section>

<script is:inline>
  document.querySelectorAll("form.kit").forEach((form) => {
    const wrap = form.parentElement;
    const success = wrap.querySelector(".kit-success");
    const error = wrap.querySelector(".kit-error");
    const hint = wrap.querySelector(".hint");
    const btn = form.querySelector("button");
    const label = btn.textContent;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      error.hidden = true;
      btn.disabled = true;
      btn.textContent = "Sending…";

      try {
        const body = new FormData(form);
        body.append("ckjs_version", "6");
        const res = await fetch(form.action, {
          method: "POST",
          body,
          headers: { Accept: "application/json", "X-CKJS-Version": "6" },
        });
        const data = await res.json();

        // "quarantined" means Kit accepted it but wants extra verification —
        // still a subscribe from the visitor's point of view.
        if (data.status === "success" || data.status === "quarantined") {
          form.hidden = true;
          if (success) success.hidden = false;
          if (hint) hint.hidden = true;
          return;
        }
        const messages = (data.errors && data.errors.messages) || [];
        throw new Error(messages.join(" ") || "That didn't go through.");
      } catch (err) {
        error.textContent =
          (err && err.message) || "Sorry, that didn't go through. Please try again.";
        error.hidden = false;
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  });
</script>

<style>
  /* Deep navy taken from the artwork so the cut-out illustrations
     (which carry their own navy ground) blend seamlessly. */
  .signup {
    --signup-navy: var(--deep-navy);
    --signup-peach: #fca995;
    --signup-peach-lip: #f0836b;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--signup-navy);
    color: #fdfbf7;
    padding-block: clamp(3rem, 6vw, 5rem);
    min-height: clamp(560px, 52vw, 900px);
    display: grid;
    align-items: center;
  }

  /* ---- decorative artwork layer ---- */
  .art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .art .d { position: absolute; height: auto; }
  .d-globe { left: 0; bottom: 0; width: min(23.9%, 400px); }
  .d-plane { right: 0; top: 4.3%; width: min(31.2%, 522px); }
  .d-passport { right: 0; bottom: 0; width: min(19.9%, 332px); }
  .d-curious { left: 3%; top: 19.7%; width: min(11.7%, 195px); }
  .d-big { right: 0.1%; top: 45.2%; width: min(9.9%, 165px); }
  .d-star-teal { left: 4.2%; top: 39.6%; width: 26px; }
  .art .dot { position: absolute; border-radius: 50%; }

  /* ---- content ---- */
  .wrap {
    max-width: 1000px;
    margin-inline: auto;
    text-align: center;
    position: relative;
  }
  .heart-top { width: 92px; height: auto; margin-bottom: 0.35rem; }

  .signup h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.1rem, 4.7vw, 3.9rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: #fdfbf7;
    margin: 0 0 0.85rem;
  }
  .sub {
    color: #c9dde7;
    font-size: clamp(1rem, 1.6vw, 1.32rem);
    line-height: 1.45;
    max-width: 27em;
    margin: 0 auto;
  }
  /* The hook line — strongest thing in the block. */
  .sub-lead {
    font-weight: 700;
    font-size: clamp(1.15rem, 1.9vw, 1.5rem);
    color: #fdfbf7;
    margin-bottom: 0.55rem;
  }

  /* ---- form ---- */
  .kit {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-top: clamp(1.5rem, 3.2vw, 2.6rem);
  }
  .kit[hidden] { display: none; }
  .field {
    flex: 0 1 670px;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: #f9f6f3;
    border-radius: 999px;
    padding: 0 1.6rem;
    height: clamp(3.1rem, 5.3vw, 4.1rem);
    box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.13);
  }
  .env {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--signup-navy);
    padding-right: 0.9rem;
    border-right: 1px solid #d9d2c9;
    box-sizing: content-box;
  }
  .kit input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    padding: 0;
    color: var(--signup-navy);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.35vw, 1.15rem);
  }
  .kit input::placeholder { color: #8b9aa5; }
  /* Suppress the ring for mouse users only — keyboard focus keeps the
     global :focus-visible outline. */
  .kit input:focus:not(:focus-visible) { outline: none; }
  .field:focus-within { box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.32); }

  .kit button {
    flex: none;
    border: 0;
    cursor: pointer;
    background: var(--signup-peach);
    color: var(--signup-navy);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    padding-inline: clamp(1.4rem, 2.6vw, 2.4rem);
    height: clamp(3.1rem, 5.3vw, 4.1rem);
    border-radius: 999px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    /* soft lip along the bottom, as in the artwork */
    box-shadow: inset 0 -4px 0 var(--signup-peach-lip);
    transition: background 0.12s ease, transform 0.12s ease;
  }
  .kit button:hover { background: var(--coral-deep); transform: translateY(-1px); }
  .kit button:disabled { opacity: 0.7; cursor: default; transform: none; }

  .kit-success {
    margin-top: 1.25rem;
    max-width: 30em;
    margin-inline: auto;
  }
  .kit-success[hidden] { display: none; }
  .kit-success-head {
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    line-height: 1.15;
    margin: 0 0 0.4rem;
  }
  .kit-success-body {
    color: #c9dde7;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    line-height: 1.45;
    margin: 0;
  }
  .kit-error {
    margin: 0.9rem auto 0;
    max-width: 34em;
    color: #ffd7cc;
    background: rgba(252, 169, 149, 0.16);
    border: 1px solid rgba(252, 169, 149, 0.5);
    border-radius: 12px;
    padding: 0.6rem 0.9rem;
    font-size: clamp(0.85rem, 1vw, 0.98rem);
  }
  .kit-error[hidden] { display: none; }
  .hint {
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    color: #8fa8b8;
    line-height: 1.5;
    max-width: 34em;
    margin-inline: auto;
    margin-top: clamp(0.9rem, 1.8vw, 1.5rem);
  }
  /* Decorative brand sign-off. Plain text — no background, border or card — so
     it reads as part of the illustration. It's kept clear of the bright globe
     and postcard art (which hug the bottom corners on mobile) by the extra
     bottom padding on .signup below, so it floats in the dark navy space. */
  .tagline {
    margin: clamp(1.5rem, 5vw, 2.5rem) auto 0;
    padding-inline: 1rem;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 2.2vw, 1.7rem);
    letter-spacing: 0.005em;
    line-height: 1.2;
    color: var(--sky);
    text-shadow: 0 1px 8px rgba(9, 26, 43, 0.55);
  }
  /* Mobile: two intentional lines. */
  .tagline-part { display: block; }
  .tagline-sep { display: none; }

  /* Tablet and up: one line, no wrapping. */
  @media (min-width: 700px) {
    .tagline { white-space: nowrap; }
    .tagline-part { display: inline; }
    .tagline-sep { display: inline; }
  }

  .setup-note {
    margin-top: 1rem;
    font-size: 0.82rem;
    color: #ffd7cc;
    background: rgba(252, 169, 149, 0.18);
    border: 1px dashed var(--coral);
    border-radius: 10px;
    padding: 0.6rem 0.8rem;
    display: inline-block;
  }
  .setup-note code { background: rgba(255, 255, 255, 0.12); padding: 0 0.3rem; border-radius: 4px; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ---- responsive ---- */
  @media (max-width: 1000px) {
    .d-curious, .d-big, .d-star-teal { display: none; }
    .wrap { max-width: 100%; }
  }
  @media (max-width: 760px) {
    .signup {
      min-height: 0;
      padding-block: clamp(2.5rem, 8vw, 4rem);
      /* Reserve a dark band under the content so the globe/postcard art
         stays in the bottom corners and never sits behind the text. */
      padding-bottom: 165px;
    }
    .kit { flex-direction: column; gap: 0.75rem; align-items: stretch; }
    .field { flex: 1 1 auto; }
    .kit button { justify-content: center; }
    .hint { max-width: 24rem; padding-inline: 24px; }
    .tagline { margin-top: clamp(1.75rem, 7vw, 2.75rem); }
    .d-globe { width: 150px; opacity: 0.9; }
    .d-passport { width: 130px; opacity: 0.9; }
    .d-plane { width: 180px; top: 1%; }
    .art .d-star { display: none; }
  }
</style>
