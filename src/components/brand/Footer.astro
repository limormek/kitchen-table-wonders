---
import { getEntry } from "astro:content";
import Container from "../ui/Container.astro";
import { Image } from "astro:assets";
import magic from "../../assets/scenery/footer-magic.png";

const brand = await getEntry("brand", "site");
const { name, footerLinks } = brand.data;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="inner">
      <a href="/" class="brand" aria-label={`${name} home`}>
        <img src="/brand/logo-white.png" alt={name} width="123" height="96"
             loading="lazy" decoding="async" />
      </a>

      <nav class="links" aria-label="Footer">
        {footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>

      <Image class="magic" src={magic} alt="Let's make more magic"
             widths={[214, 428]} sizes="214px" />
    </div>
    <p class="fine">© {year} {name}. Made for curious families.</p>
  </Container>
</footer>

<style>
  /* Sits directly under the newsletter section and shares its exact navy
     (--deep-navy) with no border or gap, so the two read as one continuous
     block. This is a compact closing bar, not another content section. */
  .site-footer {
    position: relative;
    background: var(--deep-navy);
    color: #dbe6ec;
    padding: 14px 0 18px;
  }
  /* Row 1: logo · links · tagline. Row 2: the fine print. */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2.4vw, 2rem);
    min-height: 54px;
  }
  .brand { display: inline-flex; flex: none; }
  .brand img { height: 48px; width: auto; }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2rem);
  }
  .links a {
    position: relative;
    color: #eaf1f6;
    text-decoration: none;
    font-size: clamp(0.9rem, 1.05vw, 1.05rem);
  }
  .links a:hover { color: #fff; text-decoration: underline; }
  /* hairline separators between the links, as in the artwork */
  .links a + a::before {
    content: "";
    position: absolute;
    left: calc(clamp(1rem, 2.4vw, 2rem) / -2);
    top: 50%;
    width: 1px;
    height: 1.15em;
    background: rgba(234, 241, 246, 0.35);
    transform: translateY(-50%);
  }

  .magic { flex: none; height: 42px; width: auto; }

  .fine {
    margin: 16px 0 0;
    font-size: 0.82rem;
    line-height: 1.3;
    color: rgba(219, 230, 236, 0.72);
  }

  @media (max-width: 760px) {
    .site-footer { padding: 8px 0 16px; }
    .inner { flex-direction: column; align-items: flex-start; gap: 0.85rem; }
    .brand img { height: 44px; }
    .magic { height: 38px; }
    .links { gap: 0.9rem; }
    .fine { margin-top: 14px; }
  }
</style>
