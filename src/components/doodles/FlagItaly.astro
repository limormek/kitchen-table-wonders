---
interface Props { size?: number; class?: string }
const { size = 40, class: cls = "" } = Astro.props;
---
<svg class:list={["flag", cls]} width={size} height={Math.round(size*0.667)} viewBox="0 0 24 16"
     xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="24" height="16" rx="1.5" fill="#ce2b37"/>
  <rect width="10" height="16" rx="1.5" fill="#009246"/>
  <rect x="8" width="8" height="16" fill="#fff"/>
</svg>
<style>.flag{border-radius:3px;box-shadow:0 2px 6px -2px rgba(0,0,0,.3);vertical-align:middle}</style>
