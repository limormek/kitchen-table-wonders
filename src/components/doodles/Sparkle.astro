---
interface Props { size?: number; class?: string; color?: string }
const { size = 28, class: cls = "", color = "var(--gold)" } = Astro.props;
---
<svg class:list={["sparkle-svg", cls]} width={size} height={size} viewBox="0 0 40 40"
     fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M20 0 C21.5 12.5 27.5 18.5 40 20 C27.5 21.5 21.5 27.5 20 40 C18.5 27.5 12.5 21.5 0 20 C12.5 18.5 18.5 12.5 20 0 Z"
        fill={color} />
</svg>
<style>.sparkle-svg{display:inline-block;vertical-align:middle}</style>
